{
  "name": "fang-feishu-workspace",
  "private": true,
  "version": "0.5.1",
  "description": "仿飞书工作台 - Web & Electron PC 客户端",
  "author": "Class2 Group7",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "electron:dev": "concurrently -k -n vite,electron -c green,blue \"npm:dev\" \"cross-env ELECTRON_DEV=1 ELECTRON_OPEN_DEVTOOLS=1 electron .\"",
    "electron:preview": "npm run build && cross-env ELECTRON_DEV=0 electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@heroicons/vue": "^2.1.3",
    "@microsoft/signalr": "^10.0.0",
    "@tiptap/extension-link": "^2.2.6",
    "@tiptap/extension-placeholder": "^2.2.6",
    "@tiptap/starter-kit": "^2.2.6",
    "@tiptap/vue-3": "^2.2.6",
    "agora-rtc-sdk-ng": "^4.24.5",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "pinyin-pro": "^3.18.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.fangfeishu.workspace",
    "productName": "仿飞书工作台",
    "copyright": "Copyright © 2026 Class2 Group7",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.*",
      "build/icon-*.png",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FangFeishu-PC-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "仿飞书工作台",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "FangFeishu-PC-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "FangFeishu-Mac-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "FangFeishu-Linux-${version}.${ext}"
    }
  }
}
