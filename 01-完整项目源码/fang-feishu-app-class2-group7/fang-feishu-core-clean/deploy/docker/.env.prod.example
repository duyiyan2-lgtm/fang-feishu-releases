# Copy this file to .env.prod on the Debian server, then change all passwords and domain values.

COMPOSE_PROJECT_NAME=fang-feishu

API_PORT=5080
APP_DOMAIN=example.com
CORS_ORIGIN_0=https://example.com
CORS_ORIGIN_1=http://example.com

POSTGRES_DB=fang_feishu
POSTGRES_USER=fang_feishu
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=fangfeishu_minio
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET_NAME=fang-feishu
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_ISSUER=FangFeishu
JWT_AUDIENCE=FangFeishuClients
JWT_SECRET=change-this-jwt-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=720

# Keep the real certificate only in the server-side .env.prod file.
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-primary-certificate
AGORA_TOKEN_EXPIRE_SECONDS=3600
