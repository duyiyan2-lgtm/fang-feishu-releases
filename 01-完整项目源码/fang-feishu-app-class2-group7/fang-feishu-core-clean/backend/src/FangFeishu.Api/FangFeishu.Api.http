@FangFeishu.Api_HostAddress = http://localhost:5085
@Token = replace-with-jwt
@MemberUserId = 00000000-0000-0000-0000-000000000001

GET {{FangFeishu.Api_HostAddress}}/health
Accept: application/json

###

POST {{FangFeishu.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "new_user",
  "password": "secret123",
  "realName": "New User",
  "email": "new.user@example.com",
  "phone": null,
  "clientType": "Web"
}

###

POST {{FangFeishu.Api_HostAddress}}/api/v1/im/conversations
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "type": "Group",
  "title": "项目群聊",
  "memberUserIds": ["{{MemberUserId}}"]
}

###
