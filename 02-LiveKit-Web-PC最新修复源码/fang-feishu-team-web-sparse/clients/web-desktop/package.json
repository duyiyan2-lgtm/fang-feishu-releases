{
  "name": "feishu-like-workspace",
  "private": true,
  "version": "0.4.0",
  "description": "Feishu-like Workspace - Electron Desktop App",
  "author": "Feishu Workspace Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "cross-env VITE_API_BASE=https://feishu.zhuyiyuan9.top/api/v1 VITE_WS_URL=https://feishu.zhuyiyuan9.top/hubs/im vite build",
    "icon:generate": "electron build/generate-icon.cjs",
    "preview": "vite preview --port 4173",
    "electron:dev": "concurrently -k -n vite,electron -c green,blue \"npm:dev\" \"cross-env ELECTRON_DEV=1 electron .\"",
    "electron:preview": "npm run build:desktop && cross-env ELECTRON_DEV=0 electron .",
    "electron:build": "npm run build:desktop && npm run icon:generate && electron-builder",
    "electron:build:win": "npm run build:desktop && npm run icon:generate && electron-builder --win",
    "electron:build:mac": "npm run build:desktop && npm run icon:generate && electron-builder --mac",
    "electron:build:linux": "npm run build:desktop && npm run icon:generate && electron-builder --linux"
  },
  "dependencies": {
    "@heroicons/vue": "^2.1.3",
    "@microsoft/signalr": "^10.0.0",
    "@tiptap/extension-link": "^2.2.6",
    "@tiptap/extension-placeholder": "^2.2.6",
    "@tiptap/starter-kit": "^2.2.6",
    "@tiptap/vue-3": "^2.2.6",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "livekit-client": "2.21.0",
    "pinyin-pro": "^3.18.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.feishu.workspace",
    "productName": "Feishu Workspace",
    "copyright": "Copyright © 2026 Feishu Workspace",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FangFeishu-PC-Setup-v${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Feishu Workspace"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
